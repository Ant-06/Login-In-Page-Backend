
# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017/auth_app

# Authentication secrets: replace with your own secure values
JWT_SECRET=replace-this-with-a-secure-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-this-with-another-secure-secret-32-chars

# Server configuration
PORT=3000
NODE_ENV=development

# Allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200
